########## TARGET CONFIG
# Happymodel Mobula7 (brushless / F411 whoop) uses the "CRAZYBEEF4FR" unified-target FC
# (manufacturer HAMO), STM32F411 MCU. Confirmed against a real CLI dump off this exact
# board (../BTFL_cli_M7_KK_20260713_190510_CRAZYBEEF4FR.txt: board_name CRAZYBEEF4FR,
# manufacturer_id HAMO, "Betaflight / STM32F411 (S411)"). indiflight has no per-board
# CONFIG=/config.h hydration like mainline Betaflight's `make configs` -- TARGET here
# only selects the generic F411 MCU build; board-specific pins are applied at runtime
# via `resource`/`timer`/`dma` CLI commands (see Step 3 below), not compiled in.
TARGET = STM32F411
EXTRA_FLAGS = $(EXTRA_FLAGS_CMDLINE) -D'BUILD_KEY=0000000000000000000000000000000' -D'RELEASE_NAME=indiflight-mobula7' -D'BOARD_NAME=CRAZYBEEF4FR' -D'MANUFACTURER_ID=HAMO' -DCLOUD_BUILD -DUSE_GYRO -DUSE_GYRO_SPI_MPU6000 -DUSE_GYRO_SPI_ICM20689 -DUSE_ACCGYRO_BMI270 -DUSE_GYRO_SPI_ICM42688P -DUSE_ACC -DUSE_ACC_SPI_MPU6000 -DUSE_ACC_SPI_ICM20689 -DUSE_ACC_SPI_ICM42688P -DUSE_RX_CC2500 -DUSE_DSHOT -DUSE_MAX7456 -DUSE_OSD -DUSE_OSD_SD -DUSE_BLACKBOX

########## FURTHER OPTIONS
# Developer options
#EXTRA_FLAGS += -DUSE_BENCHMARK -DUSE_STACK_CHECK

# indi config: both controllers compiled in, runtime-switchable via the
# BOXPIDCTL ("LEGACY PIDs") aux mode (fc/core.c: PID_MODE off -> INDI runs,
# PID_MODE on -> stock PID runs). PID_MODE defaults to OFF when the switch is
# unconfigured/inactive, i.e. INDI is what flies if you arm without setting up
# the switch -- to get PID as the safe/idle default, assign an aux range to
# BOXPIDCTL (permanent ID 59) that covers your transmitter switch's rest
# position, so the box is ACTIVE (PID) until you deliberately move the switch
# to fly INDI. pi-protocol's MOTOR telemetry no longer depends on this flag
# either way (telemetry/pi.c piSendMotor() reads dshotErpmf[], filtered
# directly from DSHOT bidir telemetry in drivers/dshot.c, independent of
# which controller is active) - it works the same with this on or off.
EXTRA_FLAGS += -DUSE_INDI

# telemetry config: pi-protocol active to stream IMU out (blackbox is still the actual
# log source). USE_GPS_PI is NOT needed just for this -- it only gates the *uplink* side
# (EXTERNAL_POSE/VIO_POSE/FAKE_GPS -> EKF/pos_ctl), which we're not using here. Needs a
# free UART wired out to a host and a `serial <n> 1024 ...` (FUNCTION_TELEMETRY_PI) CLI
# assignment after flashing -- default baud 921600 if left AUTO.
EXTRA_FLAGS += -DUSE_TELEMETRY -DUSE_TELEMETRY_PI

# blackbox storage: no onboard flash chip on this board (CLI dump: `resource FLASH_CS 1
# NONE`, `flash_spi_bus = 0`) -- blackbox_device is SERIAL, so USE_FLASHFS/USE_FLASH_TOOLS
# are not needed here (unlike the Foxeer H743 build, which has a W25Q128FV flash chip).

# higher level controllers / estimators -- left off: no GPS/mocap source to fuse for this
# round of testing, and EKF/pos_ctl/learner add real per-tick CPU cost the F411
# (single-precision-only FPU, no HW double) can't hide the way H7 targets can.
#EXTRA_FLAGS += -DUSE_EKF
#EXTRA_FLAGS += -DUSE_POS_CTL -DUSE_VEL_CTL
#EXTRA_FLAGS += -DUSE_TRAJECTORY_TRACKER

# accelerometer RPM filter: flagged "DANGEROUS" in the indiflight README, but it's just a
# filter (float math, no allocator/EKF involvement) -- fine on F411. USE_RPM_FILTER is
# already forced on for all STM32F4 targets (common_pre.h), so this is the only flag
# needed. Requires bidirectional DSHOT for real per-motor RPM feedback -- set at runtime,
# not compile time: `set dshot_bidir = ON` (your dump currently has it OFF).
EXTRA_FLAGS += -DUSE_ACCEL_RPM_FILTER

# DANGEROUS modes!! USE_LEARNER's RLS/QR fit (clapack/f2c, native `double`) will run via
# slow software emulation on F411's single-precision FPU -- don't enable it here.
#EXTRA_FLAGS += -DUSE_THROW_TO_ARM -DUSE_THROWING_WITHOUT_POSITION
#EXTRA_FLAGS += -DUSE_CATAPULT
#EXTRA_FLAGS += -DUSE_LEARNER
#EXTRA_FLAGS += -DUSE_NN_CONTROL
